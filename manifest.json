{
    "name": "Media Controller",
    "version": "2.0.0",
    "manifest_version": 3,
    "description": "Control the volume, pan, and speed of any media on a site.",

    "permissions":[
      "declarativeContent",
      "tabs"
    ],

    "content_scripts": [
      {
        "matches": ["<all_urls>"],
        "js": [
          "./ContentScript/media/media-state.js",
          "./ContentScript/media/media-state-store.js",
          "./ContentScript/media/media-elements.js",
          "./ContentScript/media/audio-graph.js",
          "./ContentScript/sites/empty.js",
          "./ContentScript/sites/youtube/speed-controller-element.js",
          "./ContentScript/sites/youtube/ui-adapter.js",
          "./ContentScript/sites/factories.js",
          "./ContentScript/messaging.js",
          "./ContentScript/speed-controller-callbacks.js",
          "./ContentScript/content.js"
        ]
      }
    ],

    "action": {
      "default_title": "Media Controller",
      "default_popup": "./Popup/popup.html"
    }
  }
